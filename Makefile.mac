# Riptide on the classic Mac OS (System 7, 68020 and later): the .IPP driver, a MacTCP
# replacement over the Mac's .ENET Ethernet driver (docs/MAC.md), and RiptidePrefs, the Amiga's
# MUI preferences editor built for the Mac (docs/MAC-GUI.md).
#
#   make -f Makefile.mac              build/mac/Riptide.bin and build/mac/RiptidePrefs.bin (MacBinary:
#                                     copy with `hcopy -m`)
#   make -f Makefile.mac CONF=f       with f as its riptide.conf (TEXT 128); default: DHCP on en0
#   make -f Makefile.mac AURORA68=1   development on Aurora68: the log also goes to the Pi kernel's log
#
# Needs the m68k ELF toolchain only (Debian/Ubuntu: gcc-m68k-linux-gnu, binutils-m68k-linux-gnu)
# and Python 3. The Mac-side code is GPL-2.0-only like the rest of Riptide.
CROSS   ?= m68k-linux-gnu-
CC      := $(CROSS)gcc
LD      := $(CROSS)ld
OBJCOPY := $(CROSS)objcopy
PYTHON  ?= python3
BUILD   := build/mac
GCCINC  := $(shell $(CC) -print-file-name=include)
LIBGCC  := $(shell $(CC) -m68020 -print-libgcc-file-name)
CFLAGS  := -m68020 -O2 -std=gnu99 -ffreestanding -fno-builtin -fno-pic -fno-pie -fomit-frame-pointer \
           -msoft-float -nostdinc -isystem $(GCCINC) -fno-asynchronous-unwind-tables -fno-unwind-tables \
           -fno-stack-protector -ffunction-sections -fdata-sections -Wall -Wno-unused-parameter \
           --param=min-pagesize=0 -Isrc/amiga/include -Isrc/mac -Iinclude -Iinclude/rt
ifeq ($(AURORA68),1)
CFLAGS  += -DAURORA68_LOG
endif
LDFLAGS := -T src/mac/link.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack
CORE_SRC := $(wildcard src/core/*.c)
MAC_SRC  := src/mac/os_mac.c src/mac/net_mac.c src/mac/ipp.c src/mac/ipp6.c src/mac/mactcp.c src/mac/standin.c src/mac/api_mac.c src/mac/main_mac.c src/amiga/libc.c
OBJ      := $(BUILD)/mac/drvr.o $(patsubst src/%.c,$(BUILD)/%.o,$(CORE_SRC) $(MAC_SRC))
HDRS     := $(wildcard include/rt/*.h src/core/*.h src/mac/*.h) sdk/mac/IPP6.h

all: $(BUILD)/Riptide.bin $(BUILD)/RiptidePrefs.bin $(BUILD)/RiptideDNR.bin $(BUILD)/RiptideTerminal.bin

$(BUILD)/%.o: src/%.c $(HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/mac/drvr.o: src/mac/drvr.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/drvr.elf: $(OBJ) src/mac/link.ld
	$(LD) $(LDFLAGS) -o $@ $(OBJ) $(LIBGCC) -Map $(BUILD)/drvr.map
$(BUILD)/init.bin: src/mac/init.S
	@mkdir -p $(BUILD)
	$(CC) -m68020 $(if $(filter 1,$(AURORA68)),-DAURORA68_LOG) -c -o $(BUILD)/init.o $<
	$(OBJCOPY) -O binary -j .text $(BUILD)/init.o $@
$(BUILD)/Riptide.bin: $(BUILD)/drvr.elf $(BUILD)/init.bin tools/elf2mac.py tools/mac_rsrc.py $(CONF) FORCE
	$(PYTHON) tools/elf2mac.py $(BUILD)/drvr.elf $(BUILD)/init.bin $(CONF) -o $@ --raw $(BUILD)/drvr.bin

# ---- the Riptide DNR file: the resolver MacTCP programs load ('dnrp', src/mac/dnr) ----
DNR_OBJ := $(BUILD)/dnr/dnrp_entry.o $(BUILD)/dnr/dnrp.o
$(BUILD)/dnr/dnrp_entry.o: src/mac/dnr/dnrp_entry.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/dnr/dnrp.o: src/mac/dnr/dnrp.c src/mac/prefs/mac_ipp_private.h
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/dnrp.elf: $(DNR_OBJ) src/mac/dnr/link.ld
	$(LD) -T src/mac/dnr/link.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ $(DNR_OBJ) $(LIBGCC)
$(BUILD)/RiptideDNR.bin: $(BUILD)/dnrp.elf tools/mkdnr.py tools/mac_elf.py tools/mac_rsrc.py
	$(PYTHON) tools/mkdnr.py $< -o $@

# ---- RiptidePrefs: the MUI editor's own files (src/amiga/prefs, unchanged) on the Mac's MUI ----
# The Amiga headers come with prototypes instead of jump-table calls (gen_lvos.py CC=proto, without
# the names the Mac Toolbox has: src/mac/app/traps.txt); src/mac/mui implements what is called.
APP     := $(BUILD)/app
GEN     := $(BUILD)/gen
APP_CFLAGS := -m68020 -O2 -std=gnu99 -ffreestanding -fno-builtin -fno-pic -fno-pie -ffixed-a5 -msoft-float \
           -nostdinc -isystem $(GCCINC) -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector \
           -ffunction-sections -fdata-sections -Wall -Wno-unused-parameter --param=min-pagesize=0 \
           -I$(BUILD) -Isrc/mac/app -Isrc/mac -Isrc/mac/prefs -Isrc/amiga/include -Isrc/amiga -Isrc/amiga/os \
           -Iinclude -Iinclude/rt
# the card of a riptide.conf without one: the Mac's Ethernet driver
APP_CFLAGS += -DRP_DEFAULT_IFNAME='"en0"' -DRP_DEFAULT_DEVICE='".ENET"'
# the Human Interface Guidelines in a program's own classes, where the Mac layer cannot reach
# (docs/MAC-GUI.md, "Human Interface Guidelines"); never defined for the Amiga
APP_CFLAGS += -DMM_MAC_HIG
# RiptidePrefs for the Mac: the settings nothing acts on there (FL_AMIGA) are left out of its pages
APP_CFLAGS += -DRP_ON_MAC=1
ifeq ($(AURORA68),1)
APP_CFLAGS += -DAURORA68_LOG
endif
# the editor's files from src/amiga/prefs, unchanged; mui_lang.c and driver_amiga.c have Mac
# versions (src/mac/prefs/mac_lang.c: the Mac's words; driver_mac.c: .ENET)
PREFS_AMIGA := conf_edit prefs_fields prefs_io mui_main mui_classes mui_theme mui_util mui_status \
               prefs_status status_amiga mui_counters prefs_counters prefs_driver
APP_OBJ := $(APP)/mac/app/crt0.o $(APP)/mac/app/ostraps.o $(APP)/gen/toolbox_glue.o $(APP)/mac/app/mac_alert.o \
           $(patsubst %,$(APP)/mac/mui/%.o,mm_boopsi mm_app mm_area mm_group mm_gadgets mm_gfx mm_os mm_hig mm_thunks) \
           $(APP)/mac/prefs/rp_main_mac.o $(APP)/mac/prefs/rtport_mac.o $(APP)/mac/prefs/mac_lang.o \
           $(APP)/mac/prefs/driver_mac.o \
           $(patsubst %,$(APP)/amiga/prefs/%.o,$(PREFS_AMIGA)) $(APP)/amiga/prefs/mui_thunks.o \
           $(APP)/core/printf.o $(APP)/core/inet6_text.o $(APP)/amiga/libc.o
GEN_H   := $(patsubst %,$(GEN)/%_calls.h,exec dos timer locale battclock intuition graphics gadtools icon) \
           $(GEN)/muimaster_calls.h $(GEN)/openurl_calls.h $(GEN)/bsdsocket_calls.h $(GEN)/riptide_calls.h \
           $(GEN)/usergroup_calls.h $(GEN)/toolbox_gen.h
APP_HDRS := $(wildcard include/rt/*.h src/amiga/*.h src/amiga/os/*.h src/amiga/prefs/*.h src/amiga/cmd/*.h \
            src/mac/app/*.h src/mac/mui/*.h src/mac/prefs/*.h) $(GEN_H)
TRAPS   := src/mac/app/traps.txt

$(GEN)/toolbox_gen.h $(GEN)/toolbox_glue.S: $(TRAPS) tools/mac_traps.py
	@mkdir -p $(GEN)
	$(PYTHON) tools/mac_traps.py $(TRAPS) -s $(GEN)/toolbox_glue.S -H $(GEN)/toolbox_gen.h
$(GEN)/%_calls.h: src/amiga/os/os_lvos.txt tools/gen_lvos.py $(TRAPS)
	@mkdir -p $(GEN)
	$(PYTHON) tools/gen_lvos.py call proto $< $* $@ $(TRAPS)
$(GEN)/muimaster_calls.h: src/amiga/prefs/mui_lvos.txt tools/gen_lvos.py $(TRAPS)
	@mkdir -p $(GEN)
	$(PYTHON) tools/gen_lvos.py call proto $< muimaster $@ $(TRAPS)
$(GEN)/openurl_calls.h: src/amiga/prefs/openurl_lvos.txt tools/gen_lvos.py $(TRAPS)
	@mkdir -p $(GEN)
	$(PYTHON) tools/gen_lvos.py call proto $< openurl $@ $(TRAPS)
$(GEN)/bsdsocket_calls.h $(GEN)/riptide_calls.h $(GEN)/usergroup_calls.h: $(GEN)/%_calls.h: src/amiga/lib_lvos.txt tools/gen_lvos.py $(TRAPS)
	@mkdir -p $(GEN)
	$(PYTHON) tools/gen_lvos.py call proto $< $* $@ $(TRAPS)

$(APP)/%.o: src/%.c $(APP_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -c -o $@ $<
$(APP)/%.o: src/%.S
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -c -o $@ $<
$(APP)/gen/toolbox_glue.o: $(GEN)/toolbox_glue.S
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -c -o $@ $<
$(BUILD)/RiptidePrefs.elf: $(APP_OBJ) src/mac/app/app.ld
	$(LD) -T src/mac/app/app.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ \
	      $(APP_OBJ) $(LIBGCC) -Map $(BUILD)/RiptidePrefs.map
$(BUILD)/RiptidePrefs.bin: $(BUILD)/RiptidePrefs.elf tools/elf2app.py tools/mac_elf.py tools/mac_rsrc.py
	$(PYTHON) tools/elf2app.py $< --name RiptidePrefs --creator RTPF --size 1536 -o $@

# ---- the Riptide Command Terminal: the Amiga's network tools (src/amiga/cmd, unchanged) in a Mac window ----
# Each tool's main is compiled under its own name; mm_os.c (RiptidePrefs' exec and dos) with the
# calls the terminal gives its console renamed out of the way (src/mac/term/term_os.c).
TERM      := $(BUILD)/term
TERM_TOOLS := arp ftp host hostname ifconfig ip nc netstat ping ping6 route sysctl traceroute traceroute6 speedtest
TERM_OBJ  := $(APP)/mac/app/crt0.o $(APP)/mac/app/ostraps.o $(APP)/gen/toolbox_glue.o $(APP)/mac/app/mac_alert.o \
             $(TERM)/mac/term/term_main.o $(TERM)/mac/term/term_os.o $(TERM)/mac/term/term_bsd.o $(TERM)/mac/term/term_thunks.o $(TERM)/mac/mui/mm_os.o \
             $(patsubst %,$(TERM)/amiga/cmd/%.o,cmdlib $(TERM_TOOLS)) \
             $(patsubst %,$(TERM)/apps/speedtest/%.o,st_main st_xml st_http st_util) \
             $(APP)/core/printf.o $(APP)/core/inet6_text.o $(APP)/core/netdb.o $(APP)/amiga/libc.o
TERM_HDRS := $(APP_HDRS) $(wildcard src/mac/term/*.h src/apps/speedtest/*.h)
MM_OS_RENAMES := -DRead=mm_file_Read -DWrite=mm_file_Write -DPutStr=mm_PutStr -DOpenLibrary=mm_OpenLibrary \
             -DOpenDevice=mm_OpenDevice -DCloseDevice=mm_CloseDevice -DRiptideSysCtl=mm_RiptideSysCtl \
             -DSocketBase=mm_SocketBase -DRiptideBase=mm_RiptideBase -Dc_ctl_action=mm_c_ctl_action \
             -DMM_LOG_NAME='"Riptide Command Terminal"'
$(TERM)/amiga/cmd/%.o: src/amiga/cmd/%.c $(TERM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -Damiga_main=main_$* -DSysBase=cl_SysBase -c -o $@ $<
$(TERM)/apps/speedtest/%.o: src/apps/speedtest/%.c $(TERM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -c -o $@ $<
$(TERM)/mac/mui/mm_os.o: src/mac/mui/mm_os.c $(TERM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) $(MM_OS_RENAMES) -c -o $@ $<
$(TERM)/mac/term/%.o: src/mac/term/%.c $(TERM_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -c -o $@ $<
$(TERM)/mac/term/%.o: src/mac/term/%.S
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -c -o $@ $<
$(BUILD)/RiptideTerminal.elf: $(TERM_OBJ) src/mac/term/term.ld
	$(LD) -T src/mac/term/term.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ \
	      $(TERM_OBJ) $(LIBGCC) -Map $(BUILD)/RiptideTerminal.map
$(BUILD)/RiptideTerminal.bin: $(BUILD)/RiptideTerminal.elf tools/elf2app.py tools/mac_elf.py tools/mac_rsrc.py
	$(PYTHON) tools/elf2app.py $< --name "Riptide Command Terminal" --creator RTTM --size 1024 -o $@

# ---- tests/mac: a MacTCP program that tests Riptide against the Aurora68 testbed peer ----
TEST_OBJ := $(APP)/mac/app/crt0.o $(APP)/mac/app/ostraps.o $(APP)/gen/toolbox_glue.o $(APP)/tests/mac/mactcp_test.o \
            $(APP)/core/printf.o $(APP)/amiga/libc.o $(APP)/mac/app/nocallback.o
$(APP)/tests/mac/%.o: tests/mac/%.c $(APP_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(APP_CFLAGS) -c -o $@ $<
$(BUILD)/mactcp_test.elf: $(TEST_OBJ) src/mac/app/app.ld
	$(LD) -T src/mac/app/app.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ $(TEST_OBJ) $(LIBGCC)
$(BUILD)/MacTCPTest.bin: $(BUILD)/mactcp_test.elf tools/elf2app.py
	$(PYTHON) tools/elf2app.py $< --name "MacTCP test" --creator RTMT --size 256 -o $@
# the browser test (tests/mac/http_test.c): MacTCP used as a web browser uses it, against pinet's HTTP server
HTTP_OBJ := $(APP)/mac/app/crt0.o $(APP)/mac/app/ostraps.o $(APP)/gen/toolbox_glue.o $(APP)/tests/mac/http_test.o \
            $(APP)/core/printf.o $(APP)/amiga/libc.o $(APP)/mac/app/mac_alert.o
$(BUILD)/http_test.elf: $(HTTP_OBJ) src/mac/app/app.ld
	$(LD) -T src/mac/app/app.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ $(HTTP_OBJ) $(LIBGCC)
$(BUILD)/BrowserTest.bin: $(BUILD)/http_test.elf tools/elf2app.py
	$(PYTHON) tools/elf2app.py $< --name "Browser test" --creator RTBT --size 512 -o $@
# ---- .IPP6 (docs/IPP6.md): the SDK's example program and the testbed's test, against sdk/mac/IPP6.h ----
IPP6_CFLAGS := $(APP_CFLAGS) -Isdk/mac
APP_BASE := $(APP)/mac/app/crt0.o $(APP)/mac/app/ostraps.o $(APP)/gen/toolbox_glue.o $(APP)/core/printf.o \
            $(APP)/amiga/libc.o $(APP)/mac/app/nocallback.o
$(APP)/sdk/mac/examples/ipp6get.o: sdk/mac/examples/ipp6get.c sdk/mac/IPP6.h $(APP_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(IPP6_CFLAGS) -DIPP6_EXAMPLE_RIPTIDE -c -o $@ $<
$(APP)/tests/mac/ipp6_test.o: tests/mac/ipp6_test.c sdk/mac/IPP6.h $(APP_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(IPP6_CFLAGS) -c -o $@ $<
$(BUILD)/ipp6get.elf: $(APP_BASE) $(APP)/sdk/mac/examples/ipp6get.o src/mac/app/app.ld
	$(LD) -T src/mac/app/app.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ \
	      $(APP_BASE) $(APP)/sdk/mac/examples/ipp6get.o $(LIBGCC)
$(BUILD)/ipp6get.bin: $(BUILD)/ipp6get.elf tools/elf2app.py
	$(PYTHON) tools/elf2app.py $< --name "ipp6get" --creator RT6G --size 256 -o $@
$(BUILD)/ipp6_test.elf: $(APP_BASE) $(APP)/tests/mac/ipp6_test.o src/mac/app/app.ld
	$(LD) -T src/mac/app/app.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ \
	      $(APP_BASE) $(APP)/tests/mac/ipp6_test.o $(LIBGCC)
$(BUILD)/IPP6Test.bin: $(BUILD)/ipp6_test.elf tools/elf2app.py
	$(PYTHON) tools/elf2app.py $< --name "IPP6 test" --creator RT6T --size 512 -o $@
# connections held open across a restart of the network (tests/mac/restart_test.c), MacTCP and .IPP6
$(APP)/tests/mac/restart_test.o: tests/mac/restart_test.c sdk/mac/IPP6.h $(APP_HDRS)
	@mkdir -p $(dir $@)
	$(CC) $(IPP6_CFLAGS) -c -o $@ $<
$(BUILD)/restart_test.elf: $(APP_BASE) $(APP)/tests/mac/restart_test.o src/mac/app/app.ld
	$(LD) -T src/mac/app/app.ld --emit-relocs --gc-sections --no-warn-rwx-segments -z noexecstack -o $@ \
	      $(APP_BASE) $(APP)/tests/mac/restart_test.o $(LIBGCC)
$(BUILD)/RestartTest.bin: $(BUILD)/restart_test.elf tools/elf2app.py
	$(PYTHON) tools/elf2app.py $< --name "Restart test" --creator RTRT --size 256 -o $@
examples: $(BUILD)/ipp6get.bin
# the parameter blocks of sdk/mac/IPP6.h as the m68k compiler lays them out (the host's tests/t_ipp6_layout
# checks them with 68k sizes; this builds the same test for the m68k: run it with qemu-m68k if there is one)
$(BUILD)/t_ipp6_layout: tests/t_ipp6_layout.c sdk/mac/IPP6.h
	@mkdir -p $(BUILD)
	$(CC) -std=c99 -Wall -static -o $@ $< && (command -v qemu-m68k >/dev/null && qemu-m68k $@ || true)

test: $(BUILD)/MacTCPTest.bin $(BUILD)/BrowserTest.bin $(BUILD)/IPP6Test.bin $(BUILD)/ipp6get.bin $(BUILD)/RestartTest.bin

clean:
	rm -rf $(BUILD)
FORCE:
.PHONY: all clean test examples FORCE
