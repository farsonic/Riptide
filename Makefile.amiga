# Riptide - AmigaOS build.
#
#   make -f Makefile.amiga                  vbcc (default): build/amiga/Riptide, build/amiga/rtcheck
#   make -f Makefile.amiga TOOLCHAIN=gcc    m68k-linux-gnu-gcc + tools/elf2hunk.py: build/amiga-gcc/...
#   make -f Makefile.amiga check            vamos self test + hunk/relocation checks
#
# vbcc needs VBCC (default /opt/vbcc) and the NDK 3.2 headers (NDK, default
# /opt/ndk3.2). The GCC build needs neither: it uses src/amiga/os.
TOOLCHAIN ?= vbcc
VBCC ?= /opt/vbcc
NDK  ?= /opt/ndk3.2
PYTHON ?= python3
VAMOS ?= vamos

CORE_SRC  := $(wildcard src/core/*.c)
AMIGA_SRC := src/amiga/os_amiga.c src/amiga/libs.c src/amiga/bsdsocket.c src/amiga/miami.c \
             src/amiga/usergroup.c src/amiga/sana2.c src/amiga/mni.c src/amiga/stackproc.c \
             src/amiga/main.c src/amiga/selftest.c
LIBS      := bsdsocket miami usergroup
HDRS      := $(wildcard include/rt/*.h src/amiga/*.h src/amiga/os/*.h src/core/*.h) tests/amiga/rtcheck_body.h

ifeq ($(TOOLCHAIN),gcc)
# ---------------------------------------------------------------- GCC ----
BUILD   := build/amiga-gcc
CROSS   ?= m68k-linux-gnu-
CC      := $(CROSS)gcc
LD      := $(CROSS)ld
GCCINC  := $(shell $(CC) -print-file-name=include)
LIBGCC  := $(shell $(CC) -m68020 -print-libgcc-file-name)
CFLAGS  := -m68020 -O2 -std=gnu99 -ffreestanding -fno-builtin -fno-pic -fno-pie \
           -fomit-frame-pointer -msoft-float -nostdinc -isystem $(GCCINC) \
           -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector \
           -ffunction-sections -fdata-sections -Wall -Wno-unused-parameter \
           -Isrc/amiga/include -Isrc/amiga -Isrc/amiga/os -I$(BUILD) -Iinclude -Iinclude/rt
LDFLAGS := -T src/amiga/link.ld --emit-relocs --gc-sections --no-warn-rwx-segments
GEN_H   := $(foreach l,exec dos timer,$(BUILD)/gen/$(l)_calls.h) \
           $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_impl.h $(BUILD)/gen/$(l)_calls.h) $(BUILD)/gen/mni_calls.h
GEN_OBJ := $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_vec.o)
RT_OBJ  := $(BUILD)/startup.o $(patsubst src/%.c,$(BUILD)/%.o,$(CORE_SRC) $(AMIGA_SRC) src/amiga/libc.c) \
           $(BUILD)/gcc_thunks.o $(GEN_OBJ)
RC_OBJ  := $(BUILD)/startup.o $(BUILD)/tests/rtcheck.o $(BUILD)/core/printf.o $(BUILD)/amiga/libc.o

all: $(BUILD)/Riptide $(BUILD)/rtcheck

$(BUILD)/gen/%_calls.h: src/amiga/os/os_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call gcc $< $* $@
$(BUILD)/gen/mni_calls.h: src/amiga/mni_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call gcc $< mni $@
$(foreach l,$(LIBS),$(BUILD)/gen/$(l)_calls.h): $(BUILD)/gen/%_calls.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call gcc $< $* $@
$(BUILD)/gen/%_vec.S $(BUILD)/gen/%_impl.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py impl gcc $< $* $(BUILD)/gen/$*_vec.S $(BUILD)/gen/$*_impl.h

$(BUILD)/%.o: src/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/tests/%.o: tests/amiga/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/%.o: src/amiga/%.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/gen/%.o: $(BUILD)/gen/%.S
	$(CC) $(CFLAGS) -c -o $@ $<

$(BUILD)/Riptide.elf: $(RT_OBJ) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(RT_OBJ) $(LIBGCC)
$(BUILD)/rtcheck.elf: $(RC_OBJ) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(RC_OBJ) $(LIBGCC)
$(BUILD)/%: $(BUILD)/%.elf tools/elf2hunk.py
	$(PYTHON) tools/elf2hunk.py -v $< $@

else
# --------------------------------------------------------------- vbcc ----
BUILD   := build/amiga
export VBCC
VC      := PATH=$(VBCC)/bin:$$PATH VBCC=$(VBCC) $(VBCC)/bin/vc +aos68k
CFLAGS  := -c99 -O2 -cpu=68020 -I$(NDK)/Include_H -Isrc/amiga -I$(BUILD) -Iinclude -Iinclude/rt
GEN_H   := $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_impl.h $(BUILD)/gen/$(l)_calls.h) $(BUILD)/gen/mni_calls.h
GEN_OBJ := $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_vec.o)
RT_OBJ  := $(patsubst src/%.c,$(BUILD)/%.o,$(CORE_SRC) $(AMIGA_SRC)) $(GEN_OBJ)
RC_OBJ  := $(BUILD)/tests/rtcheck.o $(BUILD)/core/printf.o

all: $(BUILD)/Riptide $(BUILD)/rtcheck

$(BUILD)/gen/mni_calls.h: src/amiga/mni_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call vbcc $< mni $@
$(BUILD)/gen/%_calls.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call vbcc $< $* $@
$(BUILD)/gen/%_vec.c $(BUILD)/gen/%_impl.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py impl vbcc $< $* $(BUILD)/gen/$*_vec.c $(BUILD)/gen/$*_impl.h

$(BUILD)/%.o: src/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(VC) $(CFLAGS) -c -o $@ $<
$(BUILD)/tests/%.o: tests/amiga/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(VC) $(CFLAGS) -Itests/amiga -c -o $@ $<
$(BUILD)/gen/%.o: $(BUILD)/gen/%.c $(GEN_H)
	$(VC) $(CFLAGS) -c -o $@ $<

$(BUILD)/Riptide: $(RT_OBJ)
	$(VC) -o $@ $(RT_OBJ) -lamiga
$(BUILD)/rtcheck: $(RC_OBJ)
	$(VC) -o $@ $(RC_OBJ) -lamiga
endif

# ------------------------------------------------------------- tests ----
check: all
	$(PYTHON) tests/amiga/test_hunk.py $(BUILD)/Riptide $(BUILD)/rtcheck
	tests/amiga/run_vamos.sh $(BUILD)/Riptide

clean:
	rm -rf $(BUILD)

.PHONY: all check clean
.SECONDARY:
