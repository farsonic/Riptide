# Riptide - AmigaOS build.
#
#   make -f Makefile.amiga                  vbcc (default): build/amiga/Riptide, build/amiga/rtcheck
#   make -f Makefile.amiga TOOLCHAIN=gcc    m68k-linux-gnu-gcc + tools/elf2hunk.py: build/amiga-gcc/...
#   make -f Makefile.amiga check            vamos self test + hunk/relocation checks
#   make -f Makefile.amiga sdk              regenerate the riptide.library SDK in sdk/
#   make -f Makefile.amiga package          Installer package: build/package/Riptide/,
#                                           build/riptide-<version>.lha (or .zip) and .adf
#
# vbcc needs VBCC (default /opt/vbcc) and the NDK 3.2 headers (NDK, default
# /opt/ndk3.2). The GCC build needs neither: it uses src/amiga/os.
TOOLCHAIN ?= vbcc
VBCC ?= /opt/vbcc
NDK  ?= /opt/ndk3.2
PYTHON ?= python3
VASM ?= $(VBCC)/bin/vasmm68k_mot
VAMOS ?= vamos

CORE_SRC  := $(wildcard src/core/*.c)
AMIGA_SRC := src/amiga/os_amiga.c src/amiga/libs.c src/amiga/bsdsocket.c src/amiga/riptidelib.c \
             src/amiga/usergroup.c src/amiga/sana2.c src/amiga/mni.c src/amiga/stackproc.c \
             src/amiga/main.c src/amiga/selftest.c src/amiga/bench.c
LIBS      := bsdsocket riptide usergroup
HDRS      := $(wildcard include/rt/*.h src/amiga/*.h src/amiga/os/*.h src/core/*.h src/amiga/cmd/*.h src/amiga/prefs/*.h \
               src/apps/speedtest/*.h) tests/amiga/rtcheck_body.h
# network tools (src/amiga/cmd), each linked with cmdlib.o
NETTOOLS  := ping ip ifconfig route arp netstat traceroute host sysctl hostname nc ftp rtdiag
# speedtest: src/amiga/cmd/speedtest.c (shim) + the portable src/apps/speedtest
TOOLS     := $(NETTOOLS) speedtest
ST_SRC    := st_main st_xml st_http st_util
# test programs linked like the tools (tests/amiga): a minimal FTP server for
# the ftp test, a minimal speedtest HTTP server for the speedtest test
TESTTOOLS := ftpd-test httpd-test netbench udpblast
# RiptidePrefs (src/amiga/prefs): GadTools preferences editor for riptide.conf
PREFS_SRC := riptideprefs conf_edit

# IPv6 variants of ping and traceroute (ping6.c / traceroute6.c include
# ping.c / traceroute.c); NETTOOLS is the list of tools linked with cmdlib
NETTOOLS  += ping6 traceroute6
TOOLS     += ping6 traceroute6

# The per-packet path, built at -O3 (inlining within a file)
HOT_SRC   := tcp_input tcp_output tcp_main tcp_timer tcp_recovery tcp_cubic tcp_cong ip inet netif \
             buf route arp timer socket socket_api checksum qos

ifeq ($(TOOLCHAIN),gcc)
# ---------------------------------------------------------------- GCC ----
BUILD   := build/amiga-gcc
CROSS   ?= m68k-linux-gnu-
CC      := $(CROSS)gcc
LD      := $(CROSS)ld
GCCINC  := $(shell $(CC) -print-file-name=include)
LIBGCC  := $(shell $(CC) -m68020 -print-libgcc-file-name)
# -mtune=68020-60: no 64-bit mulu.l/divu.l (68060 traps them to 68060.library)
CFLAGS  := -m68020 -mtune=68020-60 -DRT_ARCH_M68K_ASM -O2 -std=gnu99 -ffreestanding -fno-builtin -fno-pic -fno-pie \
           -fomit-frame-pointer -msoft-float -nostdinc -isystem $(GCCINC) \
           -fno-asynchronous-unwind-tables -fno-unwind-tables -fno-stack-protector \
           -ffunction-sections -fdata-sections -Wall -Wno-unused-parameter \
           -Isrc/amiga/include -Isrc/amiga -Isrc/amiga/os -I$(BUILD) -Iinclude -Iinclude/rt
LDFLAGS := -T src/amiga/link.ld --emit-relocs --gc-sections --no-warn-rwx-segments
GEN_H   := $(foreach l,exec dos timer locale battclock intuition gadtools graphics,$(BUILD)/gen/$(l)_calls.h) \
           $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_impl.h $(BUILD)/gen/$(l)_calls.h) $(BUILD)/gen/mni_calls.h
GEN_OBJ := $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_vec.o)
RT_OBJ  := $(BUILD)/startup.o $(patsubst src/%.c,$(BUILD)/%.o,$(CORE_SRC) $(AMIGA_SRC) src/amiga/libc.c) \
           $(BUILD)/gcc_thunks.o $(BUILD)/arch/rt_m68k.o $(GEN_OBJ)
RC_OBJ  := $(BUILD)/startup.o $(BUILD)/tests/rtcheck.o $(BUILD)/core/printf.o $(BUILD)/amiga/libc.o
TOOL_LIB := $(BUILD)/startup.o $(BUILD)/amiga/cmd/cmdlib.o $(BUILD)/core/printf.o $(BUILD)/amiga/libc.o $(BUILD)/core/inet6_text.o

all: $(BUILD)/Riptide $(BUILD)/rtcheck $(addprefix $(BUILD)/,$(TOOLS) $(TESTTOOLS)) $(BUILD)/RiptidePrefs

$(BUILD)/gen/%_calls.h: src/amiga/os/os_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call gcc $< $* $@
$(BUILD)/gen/mni_calls.h: src/amiga/mni_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call gcc $< mni $@
$(foreach l,$(LIBS),$(BUILD)/gen/$(l)_calls.h): $(BUILD)/gen/%_calls.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call gcc $< $* $@
$(BUILD)/gen/%_vec.S $(BUILD)/gen/%_impl.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py impl gcc $< $* $(BUILD)/gen/$*_vec.S $(BUILD)/gen/$*_impl.h

# about 2 % less 68020 time per TCP segment than -O2 (Riptide BENCH TX)
HOT_OBJ := $(patsubst %,$(BUILD)/core/%.o,$(HOT_SRC))
$(HOT_OBJ): CFLAGS := $(subst -O2,-O3,$(CFLAGS))

$(BUILD)/%.o: src/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/tests/%.o: tests/amiga/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/%.o: src/amiga/%.S
	@mkdir -p $(dir $@)
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/gen/%.o: $(BUILD)/gen/%.S
	$(CC) $(CFLAGS) -c -o $@ $<
$(BUILD)/arch/%.o: src/arch/m68k/%.s
	@mkdir -p $(dir $@)
	$(VASM) -quiet -m68020 -Felf -o $@ $<
	$(CROSS)objcopy --add-section .note.GNU-stack=/dev/null --set-section-flags .note.GNU-stack=contents,readonly $@

$(BUILD)/Riptide.elf: $(RT_OBJ) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(RT_OBJ) $(LIBGCC)
$(BUILD)/rtcheck.elf: $(RC_OBJ) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(RC_OBJ) $(LIBGCC)
$(addsuffix .elf,$(addprefix $(BUILD)/,$(NETTOOLS))): $(BUILD)/%.elf: $(BUILD)/amiga/cmd/%.o $(TOOL_LIB) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(TOOL_LIB) $< $(LIBGCC)
ST_OBJ  := $(BUILD)/amiga/cmd/speedtest.o $(patsubst %,$(BUILD)/apps/speedtest/%.o,$(ST_SRC))
$(BUILD)/speedtest.elf: $(ST_OBJ) $(TOOL_LIB) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(TOOL_LIB) $(ST_OBJ) $(LIBGCC)
$(BUILD)/ftpd-test.elf: $(BUILD)/tests/ftpd_test.o $(TOOL_LIB) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(TOOL_LIB) $< $(LIBGCC)
$(BUILD)/httpd-test.elf: $(BUILD)/tests/httpd_test.o $(TOOL_LIB) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(TOOL_LIB) $< $(LIBGCC)
$(BUILD)/netbench.elf: $(BUILD)/tests/netbench.o $(TOOL_LIB) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(TOOL_LIB) $< $(LIBGCC)
$(BUILD)/udpblast.elf: $(BUILD)/tests/udpblast.o $(TOOL_LIB) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(TOOL_LIB) $< $(LIBGCC)
PREFS_OBJ := $(patsubst %,$(BUILD)/amiga/prefs/%.o,$(PREFS_SRC))
$(BUILD)/RiptidePrefs.elf: $(PREFS_OBJ) $(TOOL_LIB) src/amiga/link.ld
	$(LD) $(LDFLAGS) -o $@ $(TOOL_LIB) $(PREFS_OBJ) $(LIBGCC)
$(BUILD)/%: $(BUILD)/%.elf tools/elf2hunk.py
	$(PYTHON) tools/elf2hunk.py -v $< $@

else
# --------------------------------------------------------------- vbcc ----
BUILD   := build/amiga
export VBCC
VC      := PATH=$(VBCC)/bin:$$PATH VBCC=$(VBCC) $(VBCC)/bin/vc +aos68k
CFLAGS  := -c99 -O2 -cpu=68020 -DRT_ARCH_M68K_ASM -I$(NDK)/Include_H -Isrc/amiga -I$(BUILD) -Iinclude -Iinclude/rt
GEN_H   := $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_impl.h $(BUILD)/gen/$(l)_calls.h) $(BUILD)/gen/mni_calls.h
GEN_OBJ := $(foreach l,$(LIBS),$(BUILD)/gen/$(l)_vec.o)
RT_OBJ  := $(patsubst src/%.c,$(BUILD)/%.o,$(CORE_SRC) $(AMIGA_SRC)) $(BUILD)/arch/rt_m68k.o $(GEN_OBJ)
RC_OBJ  := $(BUILD)/tests/rtcheck.o $(BUILD)/core/printf.o
TOOL_LIB := $(BUILD)/amiga/cmd/cmdlib.o $(BUILD)/core/printf.o $(BUILD)/core/inet6_text.o

all: $(BUILD)/Riptide $(BUILD)/rtcheck $(addprefix $(BUILD)/,$(TOOLS) $(TESTTOOLS)) $(BUILD)/RiptidePrefs

$(BUILD)/gen/mni_calls.h: src/amiga/mni_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call vbcc $< mni $@
$(BUILD)/gen/%_calls.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py call vbcc $< $* $@
$(BUILD)/gen/%_vec.c $(BUILD)/gen/%_impl.h: src/amiga/lib_lvos.txt tools/gen_lvos.py
	@mkdir -p $(dir $@)
	$(PYTHON) tools/gen_lvos.py impl vbcc $< $* $(BUILD)/gen/$*_vec.c $(BUILD)/gen/$*_impl.h

# about a tenth less 68020 time per TCP segment than -O2 (Riptide BENCH TX)
HOT_OBJ := $(patsubst %,$(BUILD)/core/%.o,$(HOT_SRC))
$(HOT_OBJ): CFLAGS := $(subst -O2,-O3,$(CFLAGS))

$(BUILD)/%.o: src/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(VC) $(CFLAGS) -c -o $@ $<
$(BUILD)/tests/%.o: tests/amiga/%.c $(HDRS) $(GEN_H)
	@mkdir -p $(dir $@)
	$(VC) $(CFLAGS) -Itests/amiga -c -o $@ $<
$(BUILD)/gen/%.o: $(BUILD)/gen/%.c $(GEN_H)
	$(VC) $(CFLAGS) -c -o $@ $<
$(BUILD)/arch/%.o: src/arch/m68k/%.s
	@mkdir -p $(dir $@)
	$(VASM) -quiet -m68020 -Fhunk -o $@ $<

$(BUILD)/Riptide: $(RT_OBJ)
	$(VC) -o $@ $(RT_OBJ) -lamiga
$(BUILD)/rtcheck: $(RC_OBJ)
	$(VC) -o $@ $(RC_OBJ) -lamiga
$(addprefix $(BUILD)/,$(NETTOOLS)): $(BUILD)/%: $(BUILD)/amiga/cmd/%.o $(TOOL_LIB)
	$(VC) -o $@ $< $(TOOL_LIB) -lamiga
ST_OBJ  := $(BUILD)/amiga/cmd/speedtest.o $(patsubst %,$(BUILD)/apps/speedtest/%.o,$(ST_SRC))
# cmdlib without the parts speedtest does not use (vlink keeps whole objects)
$(BUILD)/amiga/cmd/cmdlib_basic.o: src/amiga/cmd/cmdlib.c $(HDRS) $(GEN_H)
	$(VC) $(CFLAGS) -DCL_BASIC -c -o $@ $<
$(BUILD)/speedtest: $(ST_OBJ) $(BUILD)/amiga/cmd/cmdlib_basic.o $(BUILD)/core/printf.o
	$(VC) -o $@ $(ST_OBJ) $(BUILD)/amiga/cmd/cmdlib_basic.o $(BUILD)/core/printf.o -lamiga
$(BUILD)/ftpd-test: $(BUILD)/tests/ftpd_test.o $(TOOL_LIB)
	$(VC) -o $@ $< $(TOOL_LIB) -lamiga
$(BUILD)/httpd-test: $(BUILD)/tests/httpd_test.o $(TOOL_LIB)
	$(VC) -o $@ $< $(TOOL_LIB) -lamiga
$(BUILD)/netbench: $(BUILD)/tests/netbench.o $(TOOL_LIB)
	$(VC) -o $@ $< $(TOOL_LIB) -lamiga
$(BUILD)/udpblast: $(BUILD)/tests/udpblast.o $(TOOL_LIB)
	$(VC) -o $@ $< $(TOOL_LIB) -lamiga
PREFS_OBJ := $(patsubst %,$(BUILD)/amiga/prefs/%.o,$(PREFS_SRC))
$(BUILD)/RiptidePrefs: $(PREFS_OBJ) $(TOOL_LIB)
	$(VC) -o $@ $(PREFS_OBJ) $(TOOL_LIB) -lamiga

# a client built only from the SDK in sdk/ and the NDK
all: $(BUILD)/sdk_test
$(BUILD)/sdk_test: tests/amiga/sdk_test.c $(wildcard sdk/include/*/*.h)
	@mkdir -p $(dir $@)
	$(VC) -c99 -O2 -cpu=68020 -I$(NDK)/Include_H -Isdk/include -o $@ $< -lamiga
SDK_BIN := $(BUILD)/sdk_test
endif

# ping6 / traceroute6 are ping.c / traceroute.c built for IPv6
$(BUILD)/amiga/cmd/ping6.o: src/amiga/cmd/ping.c
$(BUILD)/amiga/cmd/traceroute6.o: src/amiga/cmd/traceroute.c

# ---------------------------------------------------------------- SDK ----
sdk:
	$(PYTHON) tools/gen_lvos.py sdk src/amiga/lib_lvos.txt riptide sdk

sdk-check:
	@rm -rf $(BUILD)/sdk && $(PYTHON) tools/gen_lvos.py sdk src/amiga/lib_lvos.txt riptide $(BUILD)/sdk
	@for f in $$(cd $(BUILD)/sdk && find . -type f); do \
		cmp -s $(BUILD)/sdk/$$f sdk/$$f || { echo "sdk/$$f is out of date: make -f Makefile.amiga sdk"; exit 1; }; \
	done; echo "ok   sdk/ matches src/amiga/lib_lvos.txt"

# ------------------------------------------------------------- tests ----
check: all sdk-check
	$(PYTHON) tests/amiga/test_hunk.py $(BUILD)/Riptide $(BUILD)/rtcheck $(addprefix $(BUILD)/,$(TOOLS) $(TESTTOOLS)) $(BUILD)/RiptidePrefs $(SDK_BIN)
	tests/amiga/run_vamos.sh $(BUILD)/Riptide
	tests/amiga/run_vamos_prefs.sh $(BUILD)/RiptidePrefs

# ------------------------------------------------------------ package ----
# build/package/Riptide/ (Install_Riptide, icons, C/, Docs/, SDK/, ReadMe),
# build/riptide-<version>.lha (or .zip without an LHA writer) and .adf
VERSION := $(shell sed -n 's/^\#define RIPTIDE_VERSION_STRING "\(.*\)"/\1/p' include/rt/rt_version.h)
package: all
	PYTHON=$(PYTHON) tools/mkpackage.sh $(BUILD) build $(VERSION)

clean:
	rm -rf $(BUILD)

.PHONY: all check clean sdk sdk-check package
.SECONDARY:
